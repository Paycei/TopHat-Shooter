# begin Nimble config (version 2)
when withDir(thisDir(), system.fileExists("nimble.paths")):
  include "nimble.paths"
# end Nimble config

# Cross-platform dependency resolution
# `nimble.paths` (above) is a per-machine lockfile generated by `nimble setup`.
# This repo is built from a single checkout shared by Windows and WSL/Linux
# (WSL's /mnt/d == Windows D:), so both OSes read the *same* nimble.paths --
# which only ever holds Windows absolute paths plus --noNimblePath. On Linux
# those paths don't exist, and even on Windows they are hardcoded to one user's
# home (e.g. C:\Users\<name>\.nimble), so a *different* checkout can't resolve
# them. So both OSes re-discover the deps from this user's Nimble package dir
# (a no-op on the machine that generated nimble.paths). This must be
# version-aware: several versions of a dep can be installed side by side, and
# adding the stale one to the search path could shadow the required one. So it
# picks the highest installed version of each package.
#
# IMPORTANT: this must key off the *host* machine, NOT `hostOS`/`defined(windows)`
# — both of those follow the `--os` switch during cross-compilation (e.g. an
# Android build on a Windows host reports hostOS == "android"). We instead detect
# the host from an OS-set env var that `--os` can't move: Windows always exports
# OS=Windows_NT. This lets `nimble android` on Windows still find the host's deps.
#
# raylib and its naylib bindings are not a Nimble dependency: vendor/naylib is a
# git submodule (Paycei/naylib, see its readme.md) and the game imports
# vendor/naylib/src. Its path is added after everything else because a later
# --path wins, so a naylib a stale nimble.paths still lists can never shadow it.
# bearssl is vendored in vendor/bearssl (see its TOPHAT.md) for the same
# last-path-wins reason: the Nimble package cannot be cross-compiled from a
# Windows host, so a bearssl Nimble installed must never shadow the patched copy.
import std/strutils

# OS alone: Windows always sets it, while USERPROFILE can leak into WSL through
# WSLENV and would send ship.ps1's LinuxRelease down the Windows branch.
let hostIsWindows = getEnv("OS") == "Windows_NT"

proc baseName(p: string): string =
  # Last path component, separator-agnostic (avoids relying on extractFilename
  # being available in the NimScript VM).
  let i = max(p.rfind('\\'), p.rfind('/'))
  p[i + 1 .. ^1]

proc pkgVersion(dirName: string): seq[int] =
  # "flatty-0.3.4-<hash>" -> @[0, 3, 4]; the hash field is ignored.
  let parts = dirName.split('-')
  if parts.len >= 2:
    for n in parts[1].split('.'):
      try: result.add(parseInt(n))
      except ValueError: result.add(0)

proc isNewer(a, b: seq[int]): bool =
  for i in 0 ..< max(a.len, b.len):
    let av = if i < a.len: a[i] else: 0
    let bv = if i < b.len: b[i] else: 0
    if av != bv: return av > bv
  false

let sep = if hostIsWindows: "\\" else: "/"
let nimbleHome = getEnv("NIMBLE_DIR",
  getEnv(if hostIsWindows: "USERPROFILE" else: "HOME") & sep & ".nimble")
let pkgsDir = nimbleHome & sep & "pkgs2"
if dirExists(pkgsDir):
  for pkg in ["flatty", "supersnappy"]:
    var bestDir = ""
    var bestVer: seq[int] = @[]
    for dir in listDirs(pkgsDir):
      let base = dir.baseName
      if base.startsWith(pkg & "-"):
        let v = base.pkgVersion
        if bestDir.len == 0 or isNewer(v, bestVer):
          bestDir = dir
          bestVer = v
    if bestDir.len > 0:
      switch("path", bestDir)
switch("path", thisDir() & sep & "src")
switch("path", thisDir() & sep & "vendor" & sep & "bearssl")
switch("path", thisDir() & sep & "vendor" & sep & "naylib" & sep & "src")
# Cross-compiling from Windows (e.g. Android): naylib derives raylib's include
# dir from currentSourcePath() with the *target's* path separator, which
# collapses this Windows path to "./raylib", so clang can't find raylib.h.
# Pass it absolute.
when not defined(windows):
  if hostIsWindows:
    switch("passC", "-I" & thisDir() & "/vendor/naylib/src/raylib")

# A clone made without --recursive has an empty vendor/naylib. Stop here: the
# compile would otherwise fail at "cannot open file: raylib" with no hint why, or
# worse, pick up an old naylib Nimble installed and fail on raylib 6 changes.
# (Nimble never reads config.nims, so `nimble install` still works.)
if not fileExists(thisDir() & "/vendor/naylib/src/raylib.nim"):
  quit "vendor/naylib is empty: run `git submodule update --init` (or clone with --recursive).", 1

# Mod models skin on the GPU (LookShader in mod_assets.nim), so raylib must
# upload the bone index/weight vertex buffers. naylib turns it on by default since
# raylib 6.2; it is defined here anyway so the game never depends on that default.
switch("define", "NaylibSupportGpuSkinning")

# Mods load every file format raylib can decode (mod_assets.nim ImageExts /
# FontExts, MODDING.md): naylib leaves these off by default. They only switch
# on decoders raylib already carries (stb_image, its GPU texture loaders, its
# BDF reader, dr_flac).
for format in ["Bmp", "Tga", "Jpg", "Psd", "Hdr", "Pic", "Pnm", "Ktx", "Pkm", "Pvr", "Astc",
               "Bdf", "Flac"]:
  switch("define", "NaylibSupportFileFormat" & format)
